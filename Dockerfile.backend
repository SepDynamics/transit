# Builder stage
FROM python:3.12-slim as builder

WORKDIR /app

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        g++ \
        libtbb12 \
        libtbb-dev \
        nlohmann-json3-dev \
    || apt-get install -y --no-install-recommends ca-certificates curl g++ libtbb2 libtbb-dev nlohmann-json3-dev; \
    update-ca-certificates; \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ ./scripts/
COPY src/ ./src/
RUN sh /app/scripts/build_manifold_engine.sh

# Production stage
FROM python:3.12-slim

WORKDIR /app

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libtbb12 \
    || apt-get install -y --no-install-recommends ca-certificates libtbb2; \
    update-ca-certificates; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

RUN mkdir -p logs output && \
    chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1

CMD ["python3", "scripts/transit/api.py"]
