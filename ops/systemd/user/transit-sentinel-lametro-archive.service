[Unit]
Description=Transit Sentinel LA Metro archive collector (Swiftly feeds)
After=network-online.target
Wants=network-online.target
PartOf=transit-sentinel-lametro-live.target

[Service]
Type=simple
EnvironmentFile=%h/.config/transit-sentinel/transit-sentinel-lametro.env
ExecStart=/usr/bin/env bash -lc 'cd "$TRANSIT_SENTINEL_HOME" && exec "${PYTHON_BIN:-python3}" scripts/transit/archive.py --agency "${TRANSIT_AGENCY:-lametro}" --root-dir "${LAMETRO_ARCHIVE_ROOT}" --interval "${TRANSIT_ARCHIVE_INTERVAL_SECONDS:-30}"'
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=transit-sentinel-lametro-live.target
