TRANSIT_SENTINEL_HOME=/sep/transit-sentinel
PYTHON_BIN=/usr/bin/python3
VALKEY_URL=redis://127.0.0.1:6381/15

TRANSIT_AGENCY=lametro
TRANSIT_SYSTEM_NAME="LA Metro"
TRANSIT_API_HOST=127.0.0.1
TRANSIT_API_PORT=8001
TRANSIT_REPLAY_ENABLED=0

# Current-only mode keeps raw history disabled until host capacity and feed
# retention permission are verified. When set to 0, retain at most 90 days.
TRANSIT_ARCHIVE_CURRENT_ONLY=1
TRANSIT_ARCHIVE_RETENTION_DAYS=90
TRANSIT_ARCHIVE_INTERVAL_SECONDS=30
TRANSIT_INGEST_INTERVAL_SECONDS=5
TRANSIT_HISTORY_RETENTION=720
TRANSIT_EVIDENCE_RETENTION_DAYS=90
TRANSIT_FEED_STALE_AFTER_SECONDS=90
TRANSIT_GTFS_LIGHTWEIGHT=1

LAMETRO_ARCHIVE_ROOT=/sep/transit-sentinel/data/feeds/lametro
LAMETRO_STATIC_FEED=/sep/transit-sentinel/data/feeds/lametro/current/lametro_gtfs.zip
LAMETRO_VEHICLE_FEED=/sep/transit-sentinel/data/feeds/lametro/current/VehiclePositions_enhanced.json
LAMETRO_TRIP_FEED=/sep/transit-sentinel/data/feeds/lametro/current/TripUpdates_enhanced.json
LAMETRO_ALERTS_FEED=/sep/transit-sentinel/data/feeds/lametro/current/Alerts_enhanced.json

# Required for Swiftly-hosted LA Metro feeds. Put the real key only in the
# installed, untracked ~/.config/transit-sentinel/transit-sentinel-lametro.env.
SWIFTLY_API_KEY=
